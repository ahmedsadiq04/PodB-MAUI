<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:resources="clr-namespace:PodB_MAUI.Resources"
	xmlns:model="clr-namespace:PodB_MAUI.Model"
	xmlns:ff="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
             x:Class="PodB_MAUI.MainPage">
    
    <!-- Top Navigation Bar Layout -->
    <NavigationPage.TitleView>
        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center" Padding="0,0,16,0">
            <Label Grid.Column="0"
                   Text="{Binding Source={x:Static resources:Strings.App_Title}}"
                   Style="{StaticResource Headline}"
                   FontSize="20"
                   VerticalOptions="Center" />
            <Button Grid.Column="1"
                    Text="+ Add"
                    Clicked="OnAddItemClicked"
                    CornerRadius="8"
                    Padding="12,4"
                    VerticalOptions="Center" />
        </Grid>
    </NavigationPage.TitleView>
    
    <!-- Main Content Area -->
    <Grid RowDefinitions="*" Padding="16">
        <CollectionView x:Name="GroceryCollectionView"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model:GroceryItem">
                    <Border Margin="0,0,0,12"
                            Padding="12"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnItemTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="80, *, Auto" ColumnSpacing="12">
                            
                            <!-- Thumbnail Image  -->
                            <Border Grid.Column="0"
                                    HeightRequest="80"
                                    WidthRequest="80"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0"
                                    BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#2A2A2A}">
                                <ff:CachedImage Source="{Binding photoUrl}"
                                                LoadingPlaceholder="dotnet_bot.png"
                                                ErrorPlaceholder="dotnet_bot.png"
                                                Aspect="AspectFill"
                                                HeightRequest="80"
                                                WidthRequest="80"
                                                DownsampleToViewSize="True" />
                            </Border>
                            
                            <!-- Item Info -->
                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center"
                                                 Spacing="4">
                                <Label Text="{Binding name}"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       LineBreakMode="TailTruncation" />
                                <Label Text="{Binding category}"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                                <Label Text="{Binding description}"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light=#888888, Dark=#999999}"
                                       MaxLines="2"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            
                            <!-- Price -->
                            <Label Grid.Column="2"
                                   Text="{Binding price, StringFormat='${0:F2}'}"
                                   FontAttributes="Bold"
                                   FontSize="16"
                                   TextColor="{StaticResource Primary}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>